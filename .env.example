# ============================================================
# Environment Variables — Surat Jalan Auditor
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Reconciliation Engine ---
# Minimum fuzzy similarity score (0-100) for string fields to be considered a match
FUZZY_THRESHOLD=85

# Tolerance for berat_kg comparison (in kg)
BERAT_KG_TOLERANCE=0.5

# --- API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
# Internal Docker network URL for Next.js server-side proxy
NEXT_PUBLIC_API_URL=http://backend:8000
